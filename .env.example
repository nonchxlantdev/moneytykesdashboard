VITE_USE_SUPABASE=false
VITE_ALLOW_DEMO_MODE=true
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional. Leave unset (or "/") for Vercel subdomain deploys like
# https://dashboard.moneytykes.com — assets/routes live at the host root.
# Set only for GitHub Pages project sites, e.g. /teacher-dashboard/
# VITE_BASE_PATH=/

# Never put SUPABASE_SERVICE_ROLE_KEY in Vite env — Edge Functions only.
# Never set VITE_ALLOW_DEMO_MODE=true in GitHub Pages / Vercel production —
# a misconfigured deploy must fail closed (config screen), not grant open access.
